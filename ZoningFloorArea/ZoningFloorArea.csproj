<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, DefineConstants y RevitVersion se resuelven en
       ../Directory.Build.props según la configuración (R24 / R25 / R26). -->

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ZoningFloorArea</AssemblyName>
    <RootNamespace>ZoningFloorArea</RootNamespace>
  </PropertyGroup>

  <!-- ── Referencias a la API de Revit ──────────────────────────────────
       Paquetes de solo-referencia (Nice3point): permiten compilar para
       2024/2025/2026 sin tener las tres versiones de Revit instaladas ni
       DLLs propietarias de Autodesk versionadas en el repo.
       ExcludeAssets="runtime" evita que RevitAPI.dll se copie al output;
       Revit ya la tiene cargada en su proceso.                            -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="ZoningFloorArea.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
